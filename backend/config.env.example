APP_NAME=AI Accounting Backend
APP_ENV=local
LOG_LEVEL=INFO
# SEC-OPS-001 (every local PC): see LOCAL_DEV_SETUP.md — generate your own secrets; never commit this file as .env.
# Bind loopback by default for local PC safety. Use 0.0.0.0 only if you need LAN access.
HOST=127.0.0.1
PORT=8000
# Opt-in only: allow unauthenticated X-User-ID / system+default tenant (insecure).
ALLOW_LEGACY_HEADER_AUTH=false
# Opt-in only: allow weak/default JWT_SECRET_KEY when APP_ENV=local on pure loopback (insecure).
# SEC-CODE-001: blocked when HOST is non-loopback, TRUST_FORWARDED_HEADERS=true, or CORS is non-localhost.
ALLOW_INSECURE_DEV_JWT=false
# Pure local: leave empty (or REGISTER_INVITE_CODE=) — Create account needs no invite.
# SEC-CODE-002: required when exposure is tunnel-like (non-loopback HOST,
# TRUST_FORWARDED_HEADERS=true, or non-localhost CORS_ORIGINS).
# Generate only before a tunnel: openssl rand -base64 32
# Look up later: the value lives only in this machine's backend/.env (not in git).
REGISTER_INVITE_CODE=
# Force block private/loopback gateway probe URLs even when APP_ENV=local (SSRF harden).
# Recommended true when the API may be reachable beyond this PC.
# GATEWAY_BLOCK_PRIVATE_URLS=true

# Database
DATABASE_URL=sqlite:///./ai_accounting.db
# SEC-CODE-007 (optional): encrypt the SQLite file at rest (laptop theft / shared PC).
# Generate: openssl rand -base64 32
# If you already have a plaintext DB, migrate first:
#   python scripts/encrypt_sqlite_db.py --replace
# DATABASE_PASSWORD=
# SQLITE_KEY=   # alias for DATABASE_PASSWORD
# Optional (SEC-PUB-003): encrypt local upload files at rest (Fernet). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Or any passphrase (hashed to a Fernet key). Leave empty for plaintext files.
# UPLOADS_ENCRYPTION_KEY=
# Development-only escape hatch for legacy local SQLite files. Prefer `alembic upgrade head`.
DB_AUTO_CREATE_ON_STARTUP=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=60
DB_POOL_RECYCLE=1800
DB_HEAVY_WORK_CONCURRENCY=8

# Redis (recommended for multiple API instances): distributed AI rate limits + per-company OCR concurrency
# Example: redis://localhost:6379/0
REDIS_URL=
REDIS_KEY_PREFIX=bookcomet
# When behind a reverse proxy/tunnel, set true so client IP uses X-Forwarded-For.
# Keep false for pure localhost; set true only when the tunnel/proxy is the sole public path.
TRUST_FORWARDED_HEADERS=false
AUTH_LOGIN_MAX_PER_MINUTE_PER_IP=30
AUTH_REGISTER_MAX_PER_MINUTE_PER_IP=10

# Comma-separated browser origins allowed by CORS (SEC-CODE-003: no wildcard '*').
# Local default in code: http://localhost:5173,http://127.0.0.1:5173 (and :5174).
# Before tunnel: add your HTTPS UI origin, e.g. https://your-app.example.com
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth session lifetimes (local installs: stay signed in longer)
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# REFRESH_TOKEN_EXPIRE_DAYS=365
# Required (SEC-CODE-001): random string >= 32 chars (prefer 64+). Empty/weak secrets fail boot.
# Generate: openssl rand -base64 64   |  python -c "import secrets; print(secrets.token_urlsafe(64))"
# JWT_SECRET_KEY=

# OCR / AI
# Empty OCR_PROVIDER uses Settings VLM_MODEL as the registry alias (same id as the payload).
# Set easy / tesseract / paddle only for local OCR backends.
OCR_PROVIDER=
# Optional invoice-vs-receipts classifier VLM. Empty → Settings VLM_MODEL.
# DOCUMENT_LAYOUT_CLASSIFY_MODEL=
# Optional AP-only VLM override. When empty, AP uses Settings → API VLM_MODEL.
# AP_VLM_MODEL=
# AP_MULTI_RECEIPT_OCR_MODEL=
# Optional AR-only VLM override. When empty, AR follows AP override or Settings VLM_MODEL.
# AR_OCR_MODEL=
# AP/AR receipt crop: Settings → API VLM Detect only (no OpenCV boxes). Default vlm.
# Aliases: settings, api, ai, ai_layout, qwen, qwen_only (legacy). Do not set a model id here.
# AP_DETECTION_BACKEND=vlm
# AP multi-receipt: optional legacy VLM-first layout flag (AP/AR crop ignores OpenCV fallback).
# AP_VLM_LAYOUT_CROP_ENABLED=false
# AP_VLM_LAYOUT_CONFIDENCE_MIN=0.75
# AP_VLM_LAYOUT_THUMB_MAX_SIDE=800
# AP_VLM_LAYOUT_BOX_PAD_PCT=0.02
# Layout thumbnail JPEG quality (1-100). Lower = smaller payload / faster upload. Default 88.
# AP_VLM_LAYOUT_JPEG_QUALITY=88
# Extra layout VLM attempts when JSON invalid or count != len(receipts) (0 = initial call only).
# AP_VLM_LAYOUT_MAX_RETRIES=1
# Max concurrent per-crop AP OCR tasks. Default 8; raise to 10+ if the gateway allows.
# AP_CROP_OCR_CONCURRENCY=8
# Per-crop OCR deadline (seconds). Empty uses VLM_READ_TIMEOUT → VLM_TIMEOUT → 240.
# AP_CROP_OCR_TIMEOUT_S=
# Multi-receipt crop VLM: cap longest image side before upload (0 = no resize).
# AP/AR crops always upload as JPEG (one profile). The 4-step PNG ladder is not used.
# AP_CROP_OCR_IMAGE_MAX_SIDE=0
# JPEG quality for AP/AR crop uploads. Default 90.
# AP_CROP_OCR_JPEG_QUALITY=90
# One structured VLM call per crop/page (skip document-parse OCR). Default true.
# AP_OCR_STRUCTURED_ONLY=true
# OCR/extract thinking tokens. Default off. Explicit ocr_options.enable_thinking wins.
# Leave off unless you need hidden reasoning (adds wall time; pair with a modest VLM_READ_TIMEOUT).
# VLM_ENABLE_THINKING=false
# AQ-01/AQ-02: per-crop OpenCV quality probe + optional minimal reversible enhancement (multi-receipt AP/AR).
# Default on for local testing; set false to skip entirely (original crops only).
# AP_RECEIPT_QUALITY_ENABLED=true
# AP_RECEIPT_QUALITY_ENHANCE=true
# Require this readability-score gain before replacing the original crop (original-first).
# AP_RECEIPT_QUALITY_MIN_IMPROVE=0.04
# Optional: cross-VLM model for manual AP "Double check" (full re-OCR from stored task files via POST /api/tasks/{id}/ap-cross-verify). Enables GET /health flag ap_cross_vlm_configured. When unset, the endpoint returns 503 and the UI hides the control.
# AP_CROSS_VLM_MODEL=
# Optional: separate OpenAI-compatible gateway for AP cross-VLM only. If unset, falls back to VLM_API_KEY + VLM_BASE_URL at runtime.
# AP_CROSS_VLM_API_KEY=
# AP_CROSS_VLM_BASE_URL=
# Skip the automatic AP cross pass when primary min row confidence >= this value (0-1 scale). 0 (default) never skips; manual Double check always runs the cross pass.
# AP_AUTO_CROSS_VERIFY_SKIP_PRIMARY_CONFIDENCE=0.9
# Independent local-OCR cross-check (flag-only) for AP rows: re-reads each crop/page and flags
# ocr_xcheck_{amount,currency,date,merchant}_mismatch when the VLM disagrees. Empty/off disables (default).
# "paddle" requires installing requirements-ocr.txt and running scripts/download_paddleocr_models.py;
# PaddleOCR was removed for Windows oneDNN/PIR issues, so enabling it on Windows is at your own risk. Leaves room for "cloud" later.
# AP_OCR_CROSS_CHECK_PROVIDER=paddle
# Minimum fraction of merchant-name units that must appear in the independent OCR text to count as a match (0-1). Default 0.5.
# AP_OCR_CROSS_CHECK_MERCHANT_MIN_OVERLAP=0.5
# Bank OCR model override (used only when processing_mode=BANK)
BANK_OCR_MODEL=

# Optional BANK-only VLM override. When empty, BANK uses Settings → API VLM_MODEL.
# BANK_VLM_MODEL=
# Round-2 retry (zero rows / arithmetic violations): output token budget. Default 8192 — some gateways 400 on very large values.
# BANK_VLM_R2_MAX_TOKENS=8192
# Second pass (balance/manager): BANK_CROSS_VLM_MODEL — see BANK_CROSS_VLM_* below

# Primary VLM/OCR gateway — OpenAI-compatible endpoint.
# Source of truth: Settings → API (writes these keys). Leave blank here until configured.
# URL may be with or without trailing /v1; clients normalize once (never invent a vendor host).
VLM_API_KEY=
VLM_BASE_URL=

# Text LLM gateway (manager review, AI chat, document gate, account coding).
# Blank fields soft-fallback to VLM at runtime. Configure via Settings → API.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# VLM model name and prompt template (set to match your gateway).
VLM_MODEL=
VLM_PROMPT=<image>\nFree OCR.
# Timeout in seconds for OCR requests
VLM_TIMEOUT=120
VLM_CONNECT_TIMEOUT=10
# Per-call HTTP read. Empty uses VLM_TIMEOUT. Keep modest when VLM_ENABLE_THINKING is off
# (thinking + a high read timeout can hold an empty-content call until this budget).
VLM_READ_TIMEOUT=240
# HTTP attempts per upload profile on Timeout/ConnectionError. Empty = 3. Crop OCR passes 1.
# VLM_HTTP_MAX_RETRIES=
VLM_MAX_SIDE=0
VLM_IMAGE_FORMAT=PNG
VLM_JPEG_QUALITY=85
PDF_RENDER_ZOOM=3.0
# Optional: max width*height for a rendered PDF page (PIL DecompressionBomb limit). Default follows Pillow (approx 2 * MAX_IMAGE_PIXELS).
# PDF_RENDER_MAX_PIXELS=178956970
PDF_TEXT_EXTRACTION_MIN_CHARS=200

# Standard Chartered HK: set true to use prescan-driven V2 (synthesizes "Balance Brought Forward" per section).
# Default in code is false (V1 table extract). Upload persistence now also recognises B/F labels for DB insert.
# SCB_PIPELINE_V2=true

# Bank PDF cross-VLM (model B): one extra full-page VLM call per page for balance/totals checking only.
# Runs in the dual-track VLM pipeline for both chunked and non-chunked pages; sets per-page verified / needs_review.
# When false, no extra VLM calls.
BANK_CROSS_VLM_VERIFY=false
# Required when BANK_CROSS_VLM_VERIFY=true — second VLM model id (dedicated balance-checker prompt, not row extraction).
BANK_CROSS_VLM_MODEL=
# Optional: separate OpenAI-compatible gateway for cross-VLM only. If both unset, uses VLM_API_KEY + VLM_BASE_URL.
# If only one is set, the other falls back to the main OCR settings.
BANK_CROSS_VLM_API_KEY=
BANK_CROSS_VLM_BASE_URL=
# Reserved for future parallel dual-model scheduling; v1 runs one extra sequential call per page.
BANK_CROSS_VLM_PARALLEL=true

# Hang Seng page render (AR manager / optional future prescan): HANG_SENG_RENDER_DPI, HANG_SENG_JPEG_QUALITY, HANG_SENG_MAX_SIDE (default: same chain as BEA/HSBC)
# When BANK_CROSS_VLM_VERIFY=true: extra AR-manager VLM pass per page for HSBC (annotated image),
# BEA and BOC (plain page JPEG). Manager fills balance column only; deposit/withdrawal stay from bookkeeper.
# BOC page render overrides (optional; default = same as BEA/HSBC): BOC_RENDER_DPI, BOC_JPEG_QUALITY, BOC_MAX_SIDE
HSBC_MANAGER_MAX_TOKENS=4096
HSBC_MANAGER_FULL_JSON_MAX_ROWS=15
HSBC_MANAGER_DESC_MAX_CHARS=100
HSBC_MANAGER_AMOUNT_TOLERANCE=0.02

# AI enhancement chat LLM (post-OCR field extraction).
# Blank key/url/model soft-fallback to VLM. Source of truth: Settings → API.
# Leave key empty to skip AI enhancement (will use rule-based extraction only)
AI_ENHANCE_API_KEY=

# Workflow node provider dropdown (comma-separated labels). Default: Qwen
# WORKFLOW_PROVIDERS=Qwen
# Optional routing: WORKFLOW_PROVIDER_GATEWAYS=Qwen=llm,Enhance=ai_enhance

AI_ENHANCE_BASE_URL=
AI_ENHANCE_MODEL=
AI_ENHANCE_INCLUDE_SUMMARY=false
AI_ENHANCE_REASONER_MODEL=

# Use reasoner model: "true" to enable, "false" to use regular chat model
AI_ENHANCE_USE_REASONER=false

